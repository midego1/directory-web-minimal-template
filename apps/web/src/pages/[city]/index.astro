---
/**
 * CityHome (`/<city>`) — the front door for one city, within one thumb-scroll: search,
 * the 8 categories, what is open now, the areas, and one quiet owner call-to-action.
 * Rendered at build time with the city's data so it paints before any script; the
 * "open now" list is narrowed in the browser, which knows the time.
 */
import SoiGuruLayout from '../../layouts/SoiGuruLayout.astro';
import TopBar from '../../components/soiguru/TopBar.astro';
import Icon from '../../components/soiguru/Icon.astro';
import SearchBar from '../../components/soiguru/SearchBar.astro';
import ListingCard from '../../components/soiguru/ListingCard.astro';
import OwnerCta from '../../components/soiguru/OwnerCta.astro';
import BottomNav from '../../components/soiguru/BottomNav.astro';
import { getSoiGuru, cityListings, defaultArea, claimUrl, type City } from '../../lib/soiguru/data';
import { breadcrumbJsonLd } from '../../lib/soiguru/jsonld';

export async function getStaticPaths() {
    const { cities } = await getSoiGuru();
    return cities.map((city) => ({ params: { city: city.id }, props: { city } }));
}

interface Props {
    city: City;
}

const { city } = Astro.props;
const data = await getSoiGuru();
const { config, categories } = data;
const listings = cityListings(data, city);
const area = defaultArea(city);
// Candidates for "Open now": the default area first, then the rest of the city, by rating.
const openNowCandidates = [...listings].sort(
    (a, b) => Number(b.area?.id === area?.id) - Number(a.area?.id === area?.id) || (b.rating ?? 0) - (a.rating ?? 0),
);
const areaCounts = new Map(city.areas.map((a) => [a.id, listings.filter((l) => l.area?.id === a.id).length]));
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const owner = claimUrl(config);
---

<SoiGuruLayout
    title={`${city.name}: what's open near you · ${config.company_name}`}
    description={`Restaurants, cafés, massage, tours, scooter rental, nail salons, dive shops and hotels in ${city.name}${city.name_th ? ` (${city.name_th})` : ''}, with opening hours, LINE and directions.`}
    config={config}
    path={`/${city.id}`}
    timeZone={city.timezone}
    jsonLd={[breadcrumbJsonLd(siteUrl, [[config.company_name, '/'], [city.name, `/${city.id}`]])]}
>
    <TopBar city={city} />
    <main>
        <div class="sg-header">
            <div class="tkg-small tkg-muted sg-context">
                <Icon name="pin" class="tkg-i-16" />
                {' '}<span data-th={area?.name_th ?? city.name_th}>{area?.name ?? city.name}</span> · <span data-local-time></span>
            </div>
            <h1 class="tkg-display">Find anything<br />in {city.name}</h1>
            <SearchBar city={city} hints area={area} />
        </div>

        <section class="tkg-section" style="padding-top:20px">
            <div class="tkg-section-h"><h2 data-th="หมวดหมู่">Categories</h2></div>
            <div class="tkg-cats">
                {
                    categories.slice(0, 8).map((cat) => (
                        <a class="tkg-cat" href={`/${city.id}/${cat.id}`}>
                            <Icon name={cat.icon} />
                            <span>{cat.short_name}</span>
                            {cat.name_th && <small lang="th">{cat.name_th}</small>}
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="tkg-section" data-open-now data-limit="3">
            <div class="tkg-section-h">
                <h2>
                    <span data-th={`เปิดอยู่ตอนนี้ใน${area?.name_th ?? area?.name ?? city.name_th ?? city.name}`}>Open now in {area?.name ?? city.name}</span>
                    <small>เปิดอยู่ตอนนี้ · <span data-open-count>{listings.length}</span> open in {city.name}</small>
                </h2>
                <a href={`/${city.id}/search?open=1`} data-th="ดูทั้งหมด">See all</a>
            </div>
            <div class="tkg-list">
                {openNowCandidates.map((listing, i) => <ListingCard listing={listing} hidden={i >= 3} />)}
            </div>
            <p class="sg-empty" data-open-empty hidden={listings.length > 0}>
                {listings.length === 0 ? `No places are listed in ${city.name} yet.` : `Nothing is open right now. Browse a category to see opening hours.`}
            </p>
        </section>

        {
            city.areas.length > 0 && (
                <section class="tkg-section">
                    <div class="tkg-section-h">
                        <h2>
                            <span data-th="พื้นที่">Areas</span>
                            <small>Where in {city.name}?</small>
                        </h2>
                    </div>
                    <div class="tkg-chiprow">
                        {city.areas.map((a) => (
                            <a class:list={['tkg-chip', { 'tkg-chip-on': a.id === area?.id }]} href={`/${city.id}/${a.id}`}>
                                {a.name}{' '}
                                <small>{[a.name_th, areaCounts.get(a.id)].filter((x) => x !== undefined && x !== '').join(' · ')}</small>
                            </a>
                        ))}
                    </div>
                </section>
            )
        }

        <div class="tkg-section" style="padding-bottom:24px">
            <OwnerCta cityName={city.name} href={owner} />
        </div>
    </main>
    <BottomNav city={city} active="home" ownerHref={owner} />
</SoiGuruLayout>
