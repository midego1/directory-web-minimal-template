---
/**
 * CategoryResults pages: `/<city>/<category>` (e.g. `/krabi/nail-salons`) and
 * `/<city>/<area>` (e.g. `/krabi/ao-nang`, all categories in one area). Category and area
 * ids share this URL segment; `soiguru-data` keeps them distinct.
 */
import SoiGuruLayout from '../../layouts/SoiGuruLayout.astro';
import TopBar from '../../components/soiguru/TopBar.astro';
import Icon from '../../components/soiguru/Icon.astro';
import CategoryResults from '../../components/soiguru/CategoryResults.astro';
import { getSoiGuru, cityListings, claimUrl, type Area, type Category, type City } from '../../lib/soiguru/data';
import { breadcrumbJsonLd } from '../../lib/soiguru/jsonld';

export async function getStaticPaths() {
    const data = await getSoiGuru();
    return data.cities.flatMap((city) => [
        ...data.categories.map((category) => ({ params: { city: city.id, segment: category.id }, props: { city, category } })),
        ...city.areas
            .filter((area) => !data.categories.some((c) => c.id === area.id))
            .map((area) => ({ params: { city: city.id, segment: area.id }, props: { city, area } })),
    ]);
}

interface Props {
    city: City;
    category?: Category;
    area?: Area;
}

const { city, category, area } = Astro.props;
const data = await getSoiGuru();
const { config } = data;
const listings = cityListings(data, city).filter((l) =>
    category ? l.category?.id === category.id : l.area?.id === area?.id,
);
const title = category ? category.name : (area?.name ?? city.name);
const titleTh = category ? category.name_th : area?.name_th;
const subtitle = category ? city.name : `${city.name} · all places`;
const noun = category ? category.name.toLowerCase() : 'places';
const path = `/${city.id}/${category?.id ?? area?.id}`;
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
---

<SoiGuruLayout
    title={category ? `${category.name} in ${city.name} · ${config.company_name}` : `${area?.name}, ${city.name}: places open now · ${config.company_name}`}
    description={category
        ? `${listings.length} ${noun} in ${city.name}${category.name_th ? ` (${category.name_th})` : ''}, with opening hours, prices, LINE and directions.`
        : `Restaurants, massage, tours and more in ${area?.name}, ${city.name}, with opening hours and directions.`}
    config={config}
    path={path}
    timeZone={city.timezone}
    wide
    jsonLd={[breadcrumbJsonLd(siteUrl, [[config.company_name, '/'], [city.name, `/${city.id}`], [title, path]])]}
>
    <TopBar back={{ href: `/${city.id}`, label: `Back to ${city.name}` }} title={titleTh ? `${title} · ${titleTh}` : title} subtitle={subtitle}>
        <a class="tkg-iconbtn" href={`/${city.id}/search`} aria-label="Search">
            <Icon name="search" />
        </a>
    </TopBar>
    <main>
        <CategoryResults city={city} listings={listings} noun={noun} area={area} lockArea={!!area} ownerHref={claimUrl(config)} />
    </main>
</SoiGuruLayout>
