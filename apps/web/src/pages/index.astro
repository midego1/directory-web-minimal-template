---
/**
 * SoiGuru landing (`/`) — the cities. One brand, many cities: each row opens that city's
 * home. The template's generic item listing moved to `/directory`.
 */
import SoiGuruLayout from '../layouts/SoiGuruLayout.astro';
import TopBar from '../components/soiguru/TopBar.astro';
import Icon from '../components/soiguru/Icon.astro';
import OwnerCta from '../components/soiguru/OwnerCta.astro';
import { getSoiGuru, cityListings, claimUrl } from '../lib/soiguru/data';

const data = await getSoiGuru();
const { config, cities } = data;
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const jsonLd = [
    { '@context': 'https://schema.org', '@type': 'WebSite', name: config.company_name, url: `${siteUrl}/` },
    {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: cities.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: `${siteUrl}/${c.id}` })),
    },
];
---

<SoiGuruLayout
    title={`${config.company_name}: local places in ${cities.map((c) => c.name).join(', ')}`}
    description={`Find what's open near you in ${cities.map((c) => c.name).join(', ')}: restaurants, massage, nail salons, scooters, tours and more, in English and Thai.`}
    config={config}
    path="/"
    jsonLd={jsonLd}
>
    <TopBar />
    <main>
        <div class="sg-header">
            <h1 class="tkg-display">Find anything<br />near you in Thailand</h1>
            <p class="tkg-body tkg-muted" style="margin:0">Pick a city. Places, opening hours and contacts in English and Thai.</p>
        </div>

        <section class="tkg-section">
            <div class="tkg-section-h"><h2>Cities<small>เมือง</small></h2></div>
            <div class="tkg-rows">
                {
                    cities.map((city) => {
                        const count = cityListings(data, city).length;
                        return (
                            <a class="tkg-row" href={`/${city.id}`}>
                                <div class="tkg-row-main">
                                    <span class="tkg-strong">{city.name}</span>
                                    <small>
                                        {[city.name_th, city.province && city.province !== city.name ? city.province : null, `${count} ${count === 1 ? 'place' : 'places'}`]
                                            .filter(Boolean)
                                            .join(' · ')}
                                    </small>
                                </div>
                                <Icon name="chevron-right" class="tkg-i-chev" />
                            </a>
                        );
                    })
                }
            </div>
        </section>

        <div class="tkg-section" style="padding-bottom:24px">
            <OwnerCta href={claimUrl(config)} />
        </div>
    </main>
</SoiGuruLayout>
