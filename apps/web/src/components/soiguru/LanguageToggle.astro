---
/**
 * LanguageToggle — EN / ไทย segments. The choice is remembered on the device; the page
 * script swaps every `[data-th]` text and the status sentences. Each label is written in
 * its own script so each reader finds theirs.
 */
---

<div class="tkg-lang" role="group" aria-label="Language">
    <button type="button" class="tkg-on" data-lang-set="en" aria-pressed="true">EN</button>
    <button type="button" data-lang-set="th" lang="th" aria-pressed="false">ไทย</button>
</div>
